rules_version = '2';

/**
 * Fundxtra Firestore security rules.
 *
 * **No client access, anywhere. Not reads, not writes, not authenticated, not
 * anonymous.** Every read and every mutation goes through the API, which holds
 * Admin SDK credentials and therefore bypasses these rules entirely.
 *
 * That is deliberate, and it is what lets the backend guarantee things rules
 * cannot express — that a reward credit and its ledger row commit atomically,
 * that an idempotency key makes a retry safe, that a campaign cannot overspend
 * its budget, that a PIN attempt is rate limited, that a caller only ever sees
 * their own data. A rule as innocuous as "a user may update their own
 * document" would quietly undo all of it: it would let a client set its own
 * `balanceKobo`.
 *
 * This file previously carried two narrow public-read exceptions, for platform
 * statistics and published announcements, because the marketing site read them
 * with the Firebase Web SDK. It no longer does — the site fetches both from the
 * API — so the exceptions were removed rather than left standing unused. An
 * unused hole in a ruleset is still a hole, and a public `list` on
 * `announcements` in particular let anyone enumerate that collection.
 *
 * PIN hashes deserve a specific mention: `pins/{userId}` is denied here like
 * everything else, and it lives in a collection separate from `users`
 * precisely so that no query or export over user profiles can ever carry PIN
 * material with it.
 *
 * Deploy with:
 *   firebase deploy --project fundxtra --only firestore:rules
 * or paste this file into Firebase console -> Firestore -> Rules -> Publish.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
