# ============================================================================
# Fundxtra environment configuration
#
# Copy to `.env` for local development. NEVER commit `.env` — it is gitignored.
# Every variable below is listed with WHERE TO GET IT and WHERE TO PUT IT.
#
# The API validates this file at boot and refuses to start on a bad value, and
# `GET /health` reports exactly which variables are missing, so a misconfigured
# deployment tells you what is wrong instead of crash-looping.
# ============================================================================


# ----------------------------------------------------------------------------
# BACKEND  (apps/api)  ->  set these on RAILWAY
#   Railway: your project -> the API service -> Variables -> New Variable
# ----------------------------------------------------------------------------

# Runtime. Railway sets PORT itself; do not override it there.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Origins allowed to call the API, comma-separated, no trailing slash.
# Local:      http://localhost:3000
# Production: https://fundxtra.name.ng,https://fundxtra.vercel.app
# Required in production — an empty list rejects every browser request.
CORS_ORIGINS=http://localhost:3000

# Secret used to sign Mini App session JWTs. Minimum 32 characters.
# GENERATE IT, never reuse another project's:  openssl rand -base64 48
# Rotating this invalidates every active session, which is the intended
# emergency response to a suspected leak.
SESSION_SECRET=

# --- Telegram ---------------------------------------------------------------
# TELEGRAM_BOT_TOKEN
#   From @BotFather in Telegram: /mybots -> your bot -> API Token.
#   This token is what verifies Mini App initData signatures, so without it the
#   API cannot authenticate anyone. Treat it like a password.
TELEGRAM_BOT_TOKEN=

# The bot's username, no @. Used to build referral deep links.
TELEGRAM_BOT_USERNAME=fundxtrabot

# Local UI work without a bot token. Accepts `dev:<telegramId>:<name>:<username>`
# as initData. Ignored when TELEGRAM_BOT_TOKEN is set, refuses to mint the
# primary admin id, and /health warns loudly if it is ever true in production.
ALLOW_DEV_AUTH=false

# --- Firebase Admin (server-side only) --------------------------------------
# FIREBASE_SERVICE_ACCOUNT  <- the one you want
#   Firebase console -> Project settings -> Service accounts ->
#   "Generate new private key". That downloads a JSON file. Open it, copy
#   EVERYTHING (it starts with `{` and ends with `}`), and paste the whole
#   thing as this single value.
#
#   One variable instead of three, and no multi-line PEM key to mangle in a
#   dashboard field — which is the most common way a deploy breaks. Base64 of
#   that same JSON is also accepted if a form rewrites the newlines.
#
#   If the paste is wrong, GET /health says exactly what is wrong with it
#   rather than reporting the variable as missing.
#
# NEVER put this in the frontend. It bypasses all security rules.
FIREBASE_SERVICE_ACCOUNT=

# Optional. Only needed if you are NOT using FIREBASE_SERVICE_ACCOUNT above;
# these are the same credentials split into separate fields.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

FIREBASE_PROJECT_ID=fundxtra
FIREBASE_STORAGE_BUCKET=fundxtra.firebasestorage.app

# Local development against the Firestore emulator instead of live data:
#   firebase emulators:start --only firestore
# Then uncomment. No credentials are needed in emulator mode.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Reward fulfilment ------------------------------------------------------
# Which provider delivers airtime, data, Stars and Premium.
#   none        (default) catalogue is visible and priced, everything reads
#               "coming soon", and no balance can be debited for it.
#   mock        development only. Simulates success, failure and pending so the
#               reversal path can be tested. Refused in production.
#   nasfampay   NOT YET IMPLEMENTED — their public API is still in development.
REWARD_PROVIDER=none

# NasfamPay credentials. Placeholders until their API documentation is
# published; see apps/api/src/providers/nasfampay.ts for exactly what changes
# when it is. Obtain from your NasfamPay merchant dashboard once available.
NASFAMPAY_BASE_URL=
NASFAMPAY_API_KEY=

# --- Platform ---------------------------------------------------------------
# The Telegram id that always holds SUPER_ADMIN, independent of the database,
# so the platform cannot be locked out of its own admin panel.
PRIMARY_ADMIN_TELEGRAM_ID=6438544386

# Used to build absolute links in API responses.
PUBLIC_WEB_URL=https://fundxtra.name.ng


# ============================================================================
# FRONTEND  (apps/web)  ->  NOTHING TO SET. No Vercel variables at all.
#
# Every frontend value is public by nature (an API origin, a bot handle, a
# support handle, a site URL) and is committed in apps/web/lib/config.ts. A
# Vercel deploy therefore cannot break because a variable was forgotten, and
# there is no dashboard field that could tempt a secret into the browser
# bundle. Every real secret lives on the API above.
#
# To change the API origin or the bot handle, edit apps/web/lib/config.ts and
# push. To point a LOCAL site at a different API, the overrides below still
# work in a local .env file; they are never needed in production.
#
#   NEXT_PUBLIC_API_URL, NEXT_PUBLIC_TELEGRAM_BOT,
#   NEXT_PUBLIC_SUPPORT_HANDLE, NEXT_PUBLIC_SITE_URL
#
# The Firebase web SDK is not used by the frontend — every read goes through
# the API — so no NEXT_PUBLIC_FIREBASE_* variable exists.
# ============================================================================
