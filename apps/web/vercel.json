{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm ci --include=dev",
  "buildCommand": "cd ../.. && npm run build --workspace @fundxtra/shared && npm run build --workspace @fundxtra/web",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/app",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://web.telegram.org https://*.telegram.org https://telegram.org;"
        },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://web.telegram.org https://*.telegram.org https://telegram.org;"
        },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://web.telegram.org https://*.telegram.org https://telegram.org;"
        },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://web.telegram.org https://*.telegram.org https://telegram.org;"
        },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
